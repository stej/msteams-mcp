{
  "name": "msteams-mcp",
  "version": "0.30.3",
  "description": "MCP server for Microsoft Teams - search messages, send replies, manage favourites",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "msteams-mcp": "dist/index.js",
    "msteams": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "scripts/windows-protection.ps1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m0nkmaster/msteams-mcp.git"
  },
  "homepage": "https://github.com/m0nkmaster/msteams-mcp#readme",
  "bugs": {
    "url": "https://github.com/m0nkmaster/msteams-mcp/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "mcp",
    "microsoft-teams",
    "playwright",
    "browser-automation"
  ],
  "author": "Rob MacDonald",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "marked": "^18.0.14",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.10.0",
    "eslint": "^10.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
